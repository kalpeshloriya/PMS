@app.route('/admin/roles', methods=['GET','POST'])
@login_required
@require_roles('ADMIN')
def roles():
    edit_id = request.args.get('edit_id', type=int)
    item = Role.query.get(edit_id) if edit_id else None
    if request.method == 'POST':
        name = request.form['name']
